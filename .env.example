# ---- Server ----
PORT=3000
# Internal error messages are returned to clients ONLY when this is exactly
# "development" or "test". If unset, the server behaves as production.
NODE_ENV=development

# ---- API access (required) ----
# Key that clients must send to POST /api/agents/:agentName/run, as
# "Authorization: Bearer <key>" or "X-API-Key: <key>".
# This is YOUR app's key. It is NOT the Anthropic key and must differ from it.
# Generate one with:  openssl rand -hex 32   (at least 32 characters)
# The server refuses to start while this placeholder is still set.
APP_API_KEY=replace-with-a-long-random-string

# ---- Rate limiting (POST /api/agents/:agentName/run, per client IP) ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# ---- Mode ----
# true  = agents return schema-valid fixture data. The Anthropic API is never
#         contacted and ANTHROPIC_API_KEY is not required. This is the default.
# false = live mode: real Claude + web search calls (these use API credits).
MOCK_MODE=true
# Allow the app to request LIVE research explicitly (?mode=live) while MOCK_MODE=true.
# Off by default. When true, ANTHROPIC_API_KEY is required and each live run costs credits.
LIVE_RESEARCH_ENABLED=false
# Extra cap on live runs per client IP (default: 5 per hour).
LIVE_RATE_LIMIT_WINDOW_MS=3600000
LIVE_RATE_LIMIT_MAX=5

# ---- Anthropic (only needed when MOCK_MODE=false) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Effort: low | medium | high | xhigh | max. Higher = more thorough and more tokens.
CLAUDE_EFFORT=medium
# Cap on output tokens per request, INCLUDING thinking. The report is ~4-6k tokens.
CLAUDE_MAX_TOKENS=16000
# Timeout for one API request, in milliseconds.
CLAUDE_TIMEOUT_MS=120000
# Deadline for a whole research run (all requests), in milliseconds.
CLAUDE_RUN_TIMEOUT_MS=180000
# Max API requests per run: first request + pause_turn continuations + one
# "submit your report" reminder + one correction round. A run is never restarted.
CLAUDE_MAX_TURNS=5
# Server-side refusal fallback (beta): if the model declines, Anthropic retries the
# request on a recommended fallback model in the same call. Off by default.
CLAUDE_REFUSAL_FALLBACK=false
# Automatic SDK retries per request on 429/5xx/connection errors. 0 = never retry (default).
CLAUDE_MAX_RETRIES=0

# ---- Web search (server-side tool run by Anthropic, $10 per 1,000 searches) ----
# Max searches per API request (enforced by Anthropic).
WEB_SEARCH_MAX_USES=2
# Max searches per research run (enforced by VentureLens: no further
# continuation once reached).
WEB_SEARCH_MAX_TOTAL=4
# web_search_20260209 adds dynamic filtering and is supported by claude-sonnet-5-5.
# Use web_search_20250305 only for older models or on Vertex AI.
WEB_SEARCH_TOOL_TYPE=web_search_20260209
